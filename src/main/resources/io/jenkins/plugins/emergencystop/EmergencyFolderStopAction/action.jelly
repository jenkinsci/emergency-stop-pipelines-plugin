<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:l="/lib/layout" xmlns:f="/lib/form">

  <script src="${rootURL}/plugin/emergency-stop-pipelines/index.js"></script>

  <form method="post" action="emergency-stop-folder-pipelines/stop" id="emergency-stop-folder-form" style="display:none"></form>

  <l:task
    title="Emerg. Stop Folder Pipelines"
    href="#"
    id="emergency-stop-folder-pipeline-button"
    icon="symbol-warning"
    data-form-id="emergency-stop-folder-form" />

</j:jelly>